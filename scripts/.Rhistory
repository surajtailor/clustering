test1ExpResult <- matrix(c(log(0.5/(.5^2),2), log(0.5/(.5^2),2), log(0.5/(.5^2),2), log(0.5/(.5^2),2)), nrow=2, byrow = TRUE)
#Test
test_that("should work", {expect_equal(calcInsMatrix(normInsMatrix1, prob1, count1), test1ExpResult)})
